{
  "name": "rafladesign-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/projects/*", "/blog/page/*", "/portfolio/mortdale-granny-flat", "/portfolio/mortdale-granny-flat.html"]
  },
  "send_email": [{ "name": "EMAIL" }]
}
